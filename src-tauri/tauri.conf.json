{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShrinkIt",
  "version": "1.0.0",
  "identifier": "com.dusrel.shrinkit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ShrinkIt",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      // Tuned for this app's needs: the engine renders thumbnails and
      // downloads via blob: URLs, the resize worker is an ES-module worker,
      // and libheif-js compiles WebAssembly. `ipc:`/`http://ipc.localhost`
      // keep Tauri's own JS<->Rust bridge working under the policy.
      // If devtools ever reports a CSP violation, look here first.
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' blob: data:; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Free, private, client-side image resizer and compressor",
    "longDescription": "ShrinkIt resizes, compresses and converts images 100% on your device. No uploads, no accounts, no watermarks.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
